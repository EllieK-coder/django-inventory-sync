# Copy this file to .env and fill in the values:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Never commit the real .env file.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# True for local development only
DJANGO_DEBUG=True

# Comma-separated host names the app may serve
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Product source for the sync. The app includes a demo ERP endpoint with sample data;
# point this at a real ERP API that returns {"data": [...]} to use your own.
ERP_API_URL=http://127.0.0.1:8000/demo-erp/items/